// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH MODELS (NextAuth.js v5)
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  timezone      String    @default("Asia/Karachi")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  subjects       Subject[]
  assignments    Assignment[]
  announcements  Announcement[]
  academicEvents AcademicEvent[]
  reminders      Reminder[]
  resources      Resource[]
  studyNotes     StudyNote[]
  tags           Tag[]
  inboxItems     InboxItem[]
  aiConversations AIConversation[]
  quizSessions   QuizSession[]
  studyTasks     StudyTask[]
  preferences    Preference[]
  activityLogs   ActivityLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// ACADEMIC MODELS
// ============================================

model Subject {
  id          String   @id @default(cuid())
  userId      String
  name        String
  code        String?
  semester    String?
  academicYear String?
  instructor  String?
  description String?  @db.Text
  color       String   @default("#1E3A5F")
  icon        String?
  schedule    Json?
  isArchived  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments    Assignment[]
  announcements  Announcement[]
  academicEvents AcademicEvent[]
  resources      Resource[]
  studyNotes     StudyNote[]

  @@unique([userId, name])
  @@index([userId, isArchived])
  @@map("subjects")
}

model Assignment {
  id                  String           @id @default(cuid())
  userId              String
  subjectId           String
  title               String
  description         String?          @db.Text
  instructions        String?          @db.Text
  originalAnnouncement String?         @db.Text
  assignedDate        DateTime?
  deadline            DateTime?
  deadlineConfirmed   Boolean          @default(false)
  submissionMethod    String?
  submissionLink      String?
  priority            Priority         @default(MEDIUM)
  estimatedEffort     String?
  status              AssignmentStatus @default(NOT_STARTED)
  completionDate      DateTime?
  grade               String?
  feedback            String?          @db.Text
  personalNotes       String?          @db.Text
  sortOrder           Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  reminders          Reminder[]
  history            AssignmentHistory[]
  resourceLinks      ResourceLink[]

  @@index([userId, status])
  @@index([userId, deadline])
  @@index([subjectId])
  @@map("assignments")
}

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_TO_SUBMIT
  SUBMITTED
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model AssignmentHistory {
  id           String   @id @default(cuid())
  assignmentId String
  field        String
  oldValue     String?  @db.Text
  newValue     String?  @db.Text
  changedAt    DateTime @default(now())
  reason       String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("assignment_history")
}

model Announcement {
  id              String             @id @default(cuid())
  userId          String
  subjectId       String?
  title           String?
  originalMessage String             @db.Text
  category        AnnouncementCategory @default(GENERAL)
  source          String?
  sourceGroup     String?
  dateReceived    DateTime           @default(now())
  extractedData   Json?
  personalRemarks String?            @db.Text
  isProcessed     Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  resourceLinks ResourceLink[]

  @@index([userId, isProcessed])
  @@index([subjectId])
  @@map("announcements")
}

enum AnnouncementCategory {
  ASSIGNMENT
  QUIZ
  EXAM
  PRESENTATION
  DEADLINE_CHANGE
  CLASS_CANCELLED
  SCHEDULE_CHANGE
  GENERAL
  OTHER
}

model AcademicEvent {
  id                  String        @id @default(cuid())
  userId              String
  subjectId           String?
  title               String
  eventType           EventType
  date                DateTime?
  startTime           String?
  endTime             String?
  location            String?
  description         String?       @db.Text
  originalAnnouncement String?      @db.Text
  priority            Priority      @default(MEDIUM)
  status              EventStatus   @default(UPCOMING)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  topics        EventTopic[]
  reminders     Reminder[]
  resourceLinks ResourceLink[]

  @@index([userId, date])
  @@index([userId, eventType])
  @@index([subjectId])
  @@map("academic_events")
}

enum EventType {
  QUIZ
  MIDTERM
  FINAL_EXAM
  PRESENTATION
  VIVA
  PROJECT_DEADLINE
  LAB_SUBMISSION
  PRACTICAL_EXAM
  READING_DEADLINE
  GROUP_MEETING
  CLASS
  ASSIGNMENT_DEADLINE
  CUSTOM
}

enum EventStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

model EventTopic {
  id      String @id @default(cuid())
  eventId String
  topic   String

  event AcademicEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_topics")
}

model Resource {
  id              String       @id @default(cuid())
  userId          String
  subjectId       String?
  title           String
  description     String?      @db.Text
  resourceType    ResourceType
  fileName        String?
  fileUrl         String?
  fileSize        Int?
  mimeType        String?
  storageKey      String?
  category        ResourceCategory @default(OTHER)
  isProcessed     Boolean      @default(false)
  processingStatus String?
  extractedTitle  String?
  lectureNumber   Int?
  sourceDate      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  extractedTexts ExtractedText[]
  resourceTags   ResourceTag[]
  resourceLinks  ResourceLink[]

  @@index([userId, resourceType])
  @@index([subjectId, category])
  @@map("resources")
}

enum ResourceType {
  PDF
  IMAGE
  PRESENTATION
  DOCUMENT
  SPREADSHEET
  TEXT
  LINK
  NOTE
  OTHER
}

enum ResourceCategory {
  LECTURE_SLIDES
  ASSIGNMENT
  QUIZ_MATERIAL
  EXAM_MATERIAL
  REFERENCE
  TEXTBOOK
  NOTES
  ANNOUNCEMENT
  STUDY_GUIDE
  OTHER
}

model ExtractedText {
  id         String @id @default(cuid())
  resourceId String
  pageNumber Int?
  slideNumber Int?
  content    String @db.Text
  section    String?
  createdAt  DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@map("extracted_texts")
}

model ResourceTag {
  id         String @id @default(cuid())
  resourceId String
  tagId      String

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([resourceId, tagId])
  @@map("resource_tags")
}

model Tag {
  id     String @id @default(cuid())
  userId String
  name   String
  color  String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceTags ResourceTag[]

  @@unique([userId, name])
  @@map("tags")
}

model ResourceLink {
  id             String  @id @default(cuid())
  resourceId     String
  assignmentId   String?
  eventId        String?
  announcementId String?

  resource     Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  assignment   Assignment?   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  event        AcademicEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@map("resource_links")
}

model Reminder {
  id           String        @id @default(cuid())
  userId       String
  assignmentId String?
  eventId      String?
  title        String
  message      String?
  remindAt     DateTime
  type         ReminderType  @default(DEADLINE)
  status       ReminderStatus @default(PENDING)
  isSent       Boolean       @default(false)
  sentAt       DateTime?
  createdAt    DateTime      @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  event      AcademicEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, status, remindAt])
  @@index([assignmentId])
  @@index([eventId])
  @@map("reminders")
}

enum ReminderType {
  DEADLINE
  QUIZ
  EXAM
  PRESENTATION
  STUDY
  CUSTOM
}

enum ReminderStatus {
  PENDING
  SENT
  DISMISSED
  CANCELLED
}

model StudyNote {
  id          String   @id @default(cuid())
  userId      String
  subjectId   String?
  title       String
  content     String   @db.Text
  noteType    NoteType @default(DETAILED)
  sourceResourceId String?
  sourcePages String?
  isGenerated Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, subjectId])
  @@map("study_notes")
}

enum NoteType {
  DETAILED
  REVISION
  EXAM_FOCUSED
  SUMMARY
  DEFINITIONS
  FORMULA_SHEET
  COMPARISON
  WORKED_EXAMPLES
  FLASHCARDS
  MCQ
  SHORT_ANSWER
  LONG_ANSWER
  QUESTION_BANK
}

model StudyTask {
  id          String   @id @default(cuid())
  userId      String
  subjectId   String?
  title       String
  description String?  @db.Text
  dueDate     DateTime?
  priority    Priority @default(MEDIUM)
  status      AssignmentStatus @default(NOT_STARTED)
  parentTaskId String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("study_tasks")
}

model QuizSession {
  id          String   @id @default(cuid())
  userId      String
  subjectId   String?
  title       String
  topics      String[]
  totalQuestions Int    @default(0)
  correctAnswers Int   @default(0)
  score       Float?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  createdAt   DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]

  @@index([userId])
  @@map("quiz_sessions")
}

model QuizQuestion {
  id            String       @id @default(cuid())
  sessionId     String
  question      String       @db.Text
  questionType  QuestionType
  options       Json?
  correctAnswer String       @db.Text
  explanation   String?      @db.Text
  userAnswer    String?      @db.Text
  isCorrect     Boolean?
  concept       String?
  answeredAt    DateTime?

  session QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("quiz_questions")
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
  CONCEPTUAL
  SCENARIO
  NUMERICAL
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  context   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String   @db.Text
  toolCalls      Json?
  toolResults    Json?
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model InboxItem {
  id              String      @id @default(cuid())
  userId          String
  rawContent      String      @db.Text
  contentType     String      @default("text")
  fileName        String?
  fileUrl         String?
  status          InboxStatus @default(NEW)
  extractedData   Json?
  aiConfidence    Float?
  errorMessage    String?
  processedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("inbox_items")
}

enum InboxStatus {
  NEW
  PROCESSING
  NEEDS_REVIEW
  ORGANIZED
  FAILED
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

model Preference {
  id     String @id @default(cuid())
  userId String
  key    String
  value  Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("preferences")
}
